# Copy to .env.local (gitignored, and read by Expo automatically) to point
# the app at a real deployed PocketBase server. Vars must be prefixed
# EXPO_PUBLIC_ to be inlined into the app bundle — see
# https://docs.expo.dev/guides/environment-variables/.
#
# Unset, this defaults to http://127.0.0.1:8090 — the Docker Compose
# default in backend/pocketbase/ — for local dev against a same-machine
# server (an iOS/Android simulator can usually reach 127.0.0.1 on the host;
# a physical device needs your machine's LAN IP instead).
EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
