# Copy to .env (gitignored) and fill in before running `docker compose up`.
# Used once on container start to bootstrap the first superuser account
# (see docker-entrypoint.sh) — safe to leave in place afterwards, it just
# resets the password on every restart rather than erroring.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-min-8-characters
