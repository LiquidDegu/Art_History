{
  "name": "art-history-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted backend + content pipeline for the Art History quiz app.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "import": "node scripts/import_content.js",
    "import:met": "node scripts/import_content.js --sources=met",
    "import:cleveland": "node scripts/import_content.js --sources=cleveland",
    "import:artic": "node scripts/import_content.js --sources=artic",
    "test": "node --test"
  }
}
